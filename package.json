  "exports": {
    ".": "./src/corpus-census.mjs",
    "./package.json": "./package.json",
    "./knowledge-debt-reports": "./src/knowledge-debt-reports.mjs",
    "./corpus-ledger": "./src/corpus-ledger.mjs"
  },
  "bin": {
    "census-corpus": "scripts/census-corpus.mjs"
  },
  "files": [
    "src/",
    "scripts/"
  ],
  "scripts": {
    "check": "node --check src/*.mjs && node --check scripts/*.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs"
  },
