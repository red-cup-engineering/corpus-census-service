{
  "name": "@red-cup-engineering/corpus-census-service",
  "version": "0.1.0",
  "description": "Census of every content carrier a revision tracks: ownership, kind, frontmatter, visibility, schema admission, link, wikilink and citekey resolution, and the authorship demand nothing answers yet.",
