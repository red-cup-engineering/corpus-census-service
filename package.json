    "@red-cup-engineering/markdown-engineering-services-section": "workspace:*",
    "@red-cup-engineering/organizing": "workspace:*",
    "@red-cup-engineering/term-engineering-services-section": "workspace:*",
    "@red-cup-engineering/read-markdown-structure-service": "0.2.0",
    "@red-cup-engineering/read-markdown-features-service": "0.2.0",
    "@red-cup-engineering/read-markdown-frontmatter-service": "0.2.0"
  },
