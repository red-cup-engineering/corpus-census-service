{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/ns/schema/corpus-source-custody-input-1.0.0",
  "title": "Three complete pinned Git source cuts for read-only corpus custody assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["original", "legacy", "canonical"],
  "properties": {
    "original": { "$ref": "#/$defs/sourceCut" },
    "legacy": { "$ref": "#/$defs/sourceCut" },
    "canonical": { "$ref": "#/$defs/sourceCut" }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*$" },
    "sourceCut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "revision", "prefix", "coverage", "entries"],
      "properties": {
        "kind": { "const": "corpus.git-source-cut/v1" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "revision": { "$ref": "#/$defs/oid" },
        "prefix": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/path" }] },
        "coverage": { "const": "complete" },
        "entries": { "type": "array", "maxItems": 50000, "items": {
          "type": "object", "additionalProperties": false, "required": ["path", "blob"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "blob": { "$ref": "#/$defs/oid" },
            "bytes": { "type": "integer", "minimum": 0 }
          }
        } }
      }
    }
  }
}
